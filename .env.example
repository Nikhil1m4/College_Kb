# Copy this file to .env in the repo root for the backend
# Copy this file (or the relevant lines) to frontend/.env for the frontend
APP_ENV=dev

# Backend only (secret)
# Note: Supabase dashboard may call this the "secret key"
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-never-share

# Frontend (public)
# Note: Supabase dashboard may call this the "publishable key"
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
